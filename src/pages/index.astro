---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout>
  <div id="app" class="flex flex-col h-dvh max-w-md mx-auto">
    <!-- Header -->
    <header class="flex items-center justify-between px-4 py-3 border-b border-hairline-soft">
      <h1 class="text-lg font-medium">Aura ✨</h1>
      <button id="settings-btn" class="text-steel p-2" aria-label="Settings">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </button>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 overflow-hidden">
      <!-- Chat View (default) -->
      <div id="view-chat" class="view flex flex-col h-full">
        <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
        <div class="p-3 border-t border-hairline-soft">
          <div class="flex items-end gap-2">
            <button id="voice-note-btn" class="shrink-0 w-10 h-10 rounded-md bg-cream border border-beige-deep flex items-center justify-center text-primary" aria-label="Voice note">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-14 0m7 7v4m-4 0h8m-4-16a3 3 0 00-3 3v4a3 3 0 006 0V7a3 3 0 00-3-3z"/></svg>
            </button>
            <div class="flex-1 relative">
              <textarea id="chat-input" rows="1" placeholder="Type kuch bhi... 💬" class="w-full resize-none rounded-md border border-hairline bg-canvas px-3 py-2 text-sm focus:border-primary focus:outline-none"></textarea>
            </div>
            <button id="send-btn" class="shrink-0 w-10 h-10 rounded-md bg-primary text-white flex items-center justify-center" aria-label="Send">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Tracker View -->
      <div id="view-tracker" class="view hidden h-full overflow-y-auto p-4"></div>

      <!-- Todos View -->
      <div id="view-todos" class="view hidden h-full overflow-y-auto p-4"></div>

      <!-- Call View -->
      <div id="view-call" class="view hidden h-full flex items-center justify-center"></div>
    </main>

    <!-- Bottom Navigation -->
    <nav class="flex border-t border-hairline-soft bg-canvas">
      <button class="nav-btn flex-1 flex flex-col items-center py-2 text-xs text-primary" data-view="chat">
        <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        Chat
      </button>
      <button class="nav-btn flex-1 flex flex-col items-center py-2 text-xs text-steel" data-view="tracker">
        <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Tracker
      </button>
      <button class="nav-btn flex-1 flex flex-col items-center py-2 text-xs text-steel" data-view="todos">
        <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Todos
      </button>
      <button class="nav-btn flex-1 flex flex-col items-center py-2 text-xs text-steel" data-view="call">
        <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call
      </button>
    </nav>

    <!-- Settings Modal -->
    <div id="settings-modal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-end justify-center">
      <div class="bg-canvas w-full max-w-md rounded-t-xl p-6 space-y-4">
        <h2 class="text-lg font-medium">Settings</h2>
        <div>
          <label class="text-sm text-steel block mb-1">AI API Key</label>
          <input id="api-key-input" type="password" placeholder="Enter your API key" class="w-full rounded-md border border-hairline px-3 py-2 text-sm focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="text-sm text-steel block mb-1">API Provider</label>
          <select id="api-provider" class="w-full rounded-md border border-hairline px-3 py-2 text-sm focus:border-primary focus:outline-none">
            <option value="groq">Groq (Free & Fast)</option>
            <option value="gemini">Gemini</option>
            <option value="xai">xAI Grok</option>
            <option value="openai">OpenAI</option>
          </select>
        </div>
        <div>
          <label class="text-sm text-steel block mb-1">Your Name</label>
          <input id="user-name-input" type="text" placeholder="Tumhara naam?" class="w-full rounded-md border border-hairline px-3 py-2 text-sm focus:border-primary focus:outline-none" />
        </div>
        <div>
          <label class="text-sm text-steel block mb-1">NEET Exam Date</label>
          <input id="neet-date-input" type="date" class="w-full rounded-md border border-hairline px-3 py-2 text-sm focus:border-primary focus:outline-none" />
        </div>
        <div class="flex gap-2">
          <button id="save-settings" class="flex-1 bg-primary text-white rounded-md py-2 text-sm font-medium">Save</button>
          <button id="close-settings" class="flex-1 bg-cream border border-beige-deep text-ink rounded-md py-2 text-sm font-medium">Cancel</button>
        </div>
        <div class="flex gap-2 pt-2 border-t border-hairline-soft">
          <button id="export-data" class="flex-1 text-xs text-steel border border-hairline rounded-md py-2">📦 Export</button>
          <label class="flex-1 text-xs text-steel border border-hairline rounded-md py-2 text-center cursor-pointer">
            📂 Import
            <input id="import-data" type="file" accept=".json" class="hidden" />
          </label>
        </div>
        <div class="pt-2 border-t border-hairline-soft space-y-2">
          <p class="text-xs text-steel">☁️ Google Drive Sync (auto-saves every 5 min)</p>
          <div>
            <label class="text-xs text-steel block mb-1">Google OAuth Client ID</label>
            <input id="gdrive-client-id" type="text" placeholder="From console.cloud.google.com" class="w-full rounded-md border border-hairline px-3 py-2 text-xs focus:border-primary focus:outline-none" />
          </div>
          <div class="flex gap-2">
            <button id="gdrive-connect" class="flex-1 bg-cream border border-beige-deep text-ink rounded-md py-2 text-xs font-medium">🔗 Connect Drive</button>
            <button id="gdrive-sync" class="flex-1 bg-cream border border-beige-deep text-ink rounded-md py-2 text-xs font-medium">☁️ Sync Now</button>
          </div>
        </div>
        <div class="pt-2 border-t border-hairline-soft space-y-2">
          <p class="text-xs text-steel">🍃 MongoDB — auto-saving all chats ✅</p>
        </div>
      </div>
    </div>

    <!-- Voice Recording Overlay -->
    <div id="voice-overlay" class="hidden fixed inset-0 z-50 bg-black/70 flex flex-col items-center justify-center">
      <div class="text-white text-center space-y-4">
        <div id="voice-pulse" class="w-24 h-24 rounded-full bg-primary/80 flex items-center justify-center mx-auto animate-pulse">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-14 0m7 7v4m-4 0h8m-4-16a3 3 0 00-3 3v4a3 3 0 006 0V7a3 3 0 00-3-3z"/></svg>
        </div>
        <p id="voice-timer" class="text-lg font-medium">0:00</p>
        <p class="text-sm text-white/70">Recording... tap to stop</p>
        <button id="stop-recording" class="bg-white text-ink rounded-full px-6 py-2 text-sm font-medium">Stop & Send</button>
      </div>
    </div>
  </div>

  <script src="../scripts/app.ts"></script>
</Layout>
